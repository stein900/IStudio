{
  "name": "istudio",
  "productName": "IStudio",
  "version": "1.0.0",
  "description": "IStudio — Images Studio : visionneuse et studio d'édition d'images",
  "main": "main.js",
  "author": "AHG",
  "license": "MIT",
  "scripts": {
    "dev": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "ag-psd": "^31.0.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "fr.ahg.istudio.viewer",
    "productName": "IStudio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**"
    ],
    "extraResources": [
      {
        "from": "code_source_upscale",
        "to": "code_source_upscale",
        "filter": [
          "bin/**",
          "models/**"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "fileAssociations": [
      {
        "ext": [
          "jpg",
          "jpeg",
          "jfif",
          "png",
          "gif",
          "bmp",
          "webp",
          "ico",
          "svg",
          "tif",
          "tiff",
          "avif"
        ],
        "name": "Image",
        "description": "Fichier image",
        "role": "Viewer"
      },
      {
        "ext": "psd",
        "name": "Document Photoshop",
        "description": "Document Photoshop (calques)",
        "role": "Editor"
      }
    ]
  },
  "dependencies": {}
}
